{
  // Syncro — web estática desplegada en Cloudflare Workers (Static Assets)
  // Desplegar: npx wrangler@latest deploy
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "syncro",
  "compatibility_date": "2026-09-17",
  "assets": {
    "directory": "./public/",
    "html_handling": "auto-trailing-slash"
  },
  "workers_dev": true
}
